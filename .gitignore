# Ignore build artifacts and generated files
/build/
/bin/
/fed-gen/**/build/
/fed-gen/**/src-gen/
/fed-gen/**/RTI/
/fed-gen/**/include/
/fed-gen/**/src/**/.*_preamble.h
/fed-gen/**/src/**/extension.cmake

# Ignore editor and system files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Ignore logs and temporary files
*.log
*.tmp
*.temp
*.bak

# Ignore Python artifacts if any
__pycache__/
*.py[cod]

# Ignore environment files
.env
*.env

# Ignore user-specific VS Code settings
.vscode/

# Ignore build system files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt

# Ignore other generated binary files
*.o
*.obj
*.so
*.dylib
*.dll
*.exe
*.out
*.a
*.lib
