/**
 * @file GNSSReceiver.lf
 * @brief GNSS receiver generating RTCM3 correction data packets
 * @date 2026-05-13
 */
target C

preamble {=
  #include "gnss_common.h"
  #include <stdlib.h>
  #include <string.h>
  #include <time.h>

  /**
   * @brief Compute a lightweight 24-bit checksum over a byte buffer.
   *
   * This is a non-standard CRC-24 variant used for simulation purposes only.
   * It is NOT the RTCM CRC-24Q algorithm; it is faster and sufficient for
   * detecting accidental corruption in synthetic test data.
   *
   * @param data  Pointer to the input byte buffer.
   * @param len   Number of bytes to checksum.
   * @return      24-bit checksum value (upper 8 bits are always zero).
   */
  static inline uint32_t simple_crc24(const uint8_t* data, int len) {
    uint32_t crc = 0x00ABCDEF;
    for (int i = 0; i < len; i++) {
      crc ^= data[i];
      crc = ((crc << 5) | (crc >> 19)) & 0xFFFFFF;
      crc = (crc + 0x1F3D5B) & 0xFFFFFF;
    }
    return crc & 0xFFFFFF;
  }

  /**
   * @brief Compute the CRC-32 (IEEE 802.3) integrity field for an E2E packet.
   *
   * The CRC covers the following fields of the E2E header and payload:
   *   - Bytes 4..5  : E2E Length
   *   - Bytes 6..7  : E2E Counter
   *   - Bytes 8..11 : E2E Data ID
   *   - Bytes 16..N : Full RTCM3 payload (everything after the E2E header)
   *
   * Bytes 0..3 (preamble) and 12..15 (the CRC field itself) are excluded.
   * The result is written big-endian into bytes 12..15 of the packet by the
   * caller (@see build_demo_gnss_packet).
   *
   * @param packet  Pointer to the fully populated packet whose CRC is to be computed.
   *                Must have @c packet->bytes >= E2E_HEADER_SIZE.
   * @return        32-bit CRC value (finalised with bitwise NOT per IEEE 802.3).
   */
  static inline uint32_t compute_e2e_crc(const data_packet_t* packet) {
    uint32_t crc = 0xFFFFFFFFU;

    // Include E2E Length, Counter, and Data ID (bytes 4..11).
    crc = crc32_ieee_update(crc, &packet->data[4], 8);

    // Skip E2E CRC field (bytes 12..15), then include full RTCM payload.
    if (packet->bytes > E2E_HEADER_SIZE) {
      crc = crc32_ieee_update(crc, &packet->data[E2E_HEADER_SIZE],
                              packet->bytes - E2E_HEADER_SIZE);
    }

    return ~crc;
  }

  /*
   * Packet format emitted by GNSSReceiver (byte stream over UART):
   *
   *   +------------------------------ E2E Header (16 bytes) ------------------------------+
  *   | B0..B3  | B4..B5       | B6..B7      | B8..B11      | B12..B15                    |
  *   | Preamble| E2E Length   | E2E Counter | E2E Data ID  | E2E CRC (CRC-32)            |
  *   |0F F0 5A | Total packet | Big-endian  | Big-endian   | over [B4..B11]+payload      |
   *   |03       | bytes (BE)   |             |              |                             |
   *   +-----------------------------------------------------------------------------------+
   *   +--------------------------- Payload: RTCM3 messages -------------------------------+
   *   | RTCM #1 | RTCM #2 | ... | RTCM #N                                                |
   *   +-----------------------------------------------------------------------------------+
   *
   *   Each RTCM3 message encoded as:
   *     +--------------------+----------------------+--------------------+-----------+
   *     | Byte 0             | Bytes 1..2           | Bytes 3..(3+L-1)   | Last 3    |
   *     | RTCM preamble 0xD3 | RTCM content len L   | RTCM content       | CRC bytes |
   *     |                    | (10-bit, BE fields)  | (message id starts | (modeled  |
   *     |                    |                      | at first 2 bytes)  | placeholder)
   *     +--------------------+----------------------+--------------------+-----------+
   */
static inline void build_demo_gnss_packet(data_packet_t* packet,
                                            uint16_t e2e_counter,
                                            uint32_t data_id,
                                            int rtcm_count,
                                            int target_total_bytes,
                                            instant_t generation_time) {
    // Start from a clean packet buffer.
    memset(packet, 0, sizeof(*packet));
    packet->generation_time = generation_time;
    packet->packet_info.e2e_counter = e2e_counter;
    packet->packet_info.e2e_data_id = data_id;

    // Keep requested RTCM count within supported bounds.
    if (rtcm_count < 1) {
      rtcm_count = 1;
    }
    if (rtcm_count > MAX_RTCM_MESSAGES_PER_PACKET) {
      rtcm_count = MAX_RTCM_MESSAGES_PER_PACKET;
    }

    // Ensure packet size can hold E2E header and all RTCM message overhead.
    int min_total = E2E_HEADER_SIZE + rtcm_count * (RTCM3_OVERHEAD + 2);
    if (target_total_bytes < min_total) {
      target_total_bytes = min_total;
    }
    if (target_total_bytes > MAX_PACKET_SIZE) {
      target_total_bytes = MAX_PACKET_SIZE;
    }

    // Write fixed E2E header fields.
    packet->data[0] = E2E_PREAMBLE_0;
    packet->data[1] = E2E_PREAMBLE_1;
    packet->data[2] = E2E_PREAMBLE_2;
    packet->data[3] = E2E_PREAMBLE_3;
    packet->data[6] = (uint8_t)((e2e_counter >> 8) & 0xFF);
    packet->data[7] = (uint8_t)(e2e_counter & 0xFF);
    packet->data[8] = (uint8_t)((data_id >> 24) & 0xFF);
    packet->data[9] = (uint8_t)((data_id >> 16) & 0xFF);
    packet->data[10] = (uint8_t)((data_id >> 8) & 0xFF);
    packet->data[11] = (uint8_t)(data_id & 0xFF);

    // Payload starts right after the 16-byte E2E header.
    int offset = E2E_HEADER_SIZE;

    for (int i = 0; i < rtcm_count; i++) {
      // Evenly distribute remaining bytes across remaining messages.
      int remaining_msgs = rtcm_count - i;
      int remaining_bytes = target_total_bytes - offset;
      int bytes_this_msg = remaining_bytes / remaining_msgs;
      if (bytes_this_msg < RTCM3_OVERHEAD + 2) {
        bytes_this_msg = RTCM3_OVERHEAD + 2;
      }

      int content_length = bytes_this_msg - RTCM3_OVERHEAD;
      uint16_t message_id = (uint16_t)(1000 + ((e2e_counter * 17 + i * 29) % 3000));

      // RTCM header: preamble + 10-bit content length.
      packet->data[offset] = RTCM3_PREAMBLE;
      packet->data[offset + 1] = (uint8_t)((content_length >> 8) & 0x03);
      packet->data[offset + 2] = (uint8_t)(content_length & 0xFF);

      // First two content bytes encode the synthetic RTCM message ID.
      packet->data[offset + 3] = (uint8_t)((message_id >> 4) & 0xFF);
      packet->data[offset + 4] = (uint8_t)((message_id & 0x0F) << 4);

      // Fill remaining content bytes with deterministic demo data.
      for (int j = 2; j < content_length; j++) {
        packet->data[offset + 3 + j] = (uint8_t)((e2e_counter + i + j) & 0xFF);
      }

      // Append simple 24-bit checksum over RTCM header + content.
      uint32_t crc24 = simple_crc24(&packet->data[offset], RTCM3_HEADER_SIZE + content_length);
      packet->data[offset + 3 + content_length] = (uint8_t)((crc24 >> 16) & 0xFF);
      packet->data[offset + 4 + content_length] = (uint8_t)((crc24 >> 8) & 0xFF);
      packet->data[offset + 5 + content_length] = (uint8_t)(crc24 & 0xFF);

      offset += bytes_this_msg;
    }

    // Finalize packet size fields and summary metadata.
    packet->bytes = offset;
    packet->packet_info.e2e_length = (uint16_t)offset;
    packet->data[4] = (uint8_t)((offset >> 8) & 0xFF);
    packet->data[5] = (uint8_t)(offset & 0xFF);

    // Compute and write E2E CRC to bytes 12..15.
    uint32_t e2e_crc = compute_e2e_crc(packet);
    packet->data[12] = (uint8_t)((e2e_crc >> 24) & 0xFF);
    packet->data[13] = (uint8_t)((e2e_crc >> 16) & 0xFF);
    packet->data[14] = (uint8_t)((e2e_crc >> 8) & 0xFF);
    packet->data[15] = (uint8_t)(e2e_crc & 0xFF);

    packet->packet_info.rtcm_count = rtcm_count;
  }
=}

/**
 * @reactor GNSSReceiver
 * @brief Simulates a GNSS hardware module producing RTCM3 correction data packets.
 *
 * On every 100 ms epoch timer tick, exactly one E2E packet is generated and
 * scheduled for byte-by-byte emission at the configured baud rate.  Each E2E
 * packet contains a 16-byte integrity header (preamble, length, counter, data ID,
 * CRC-32) followed by 1–6 RTCM3 messages.  Bytes are emitted individually via
 * the @c emit_byte logical action so that @c UARTDriver receives one byte per
 * event, faithfully modelling the byte-serial nature of a physical UART link.
 *
 * The reactor drives a three-phase simulation:
 *   - Phase 1 (@c convergence_epochs): AIMD adaptive algorithm learns the safe
 *     ISR latency ceiling; overflows are expected.
 *   - Phase 2 (@c validation_epochs): system runs at the converged ceiling;
 *     zero overflows expected.
 *   - Phase 3 (@c sweep_epochs): structured threshold sweep across all boundary
 *     values to experimentally verify the safety formula.
 *
 * @param min_bytes                   Minimum total packet size in bytes (dual-constellation baseline).
 * @param max_bytes                   Maximum total packet size in bytes (quad-constellation maximum).
 * @param min_rtcm_messages_per_e2e   Minimum number of RTCM3 messages per E2E packet.
 * @param max_rtcm_messages_per_e2e   Maximum number of RTCM3 messages per E2E packet.
 * @param baudrate                    Serial baud rate (bits/s); must match @c UARTDriver.
 *                                    Controls the byte-emission interval:
 *                                    byte_time = 10 × 10⁶ / baudrate µs.
 * @param convergence_epochs          Number of epochs in Phase 1 (AIMD convergence).
 * @param validation_epochs           Number of epochs in Phase 2 (zero-overflow validation).
 * @param sweep_epochs                Number of epochs in Phase 3 (threshold sweep); 0 disables.
 */
  /**
   * @brief Serialise a complete E2E packet into individual UART bytes.
   *
   * Iterates over every byte in the buffered E2E packet and schedules a
   * separate @c emit_byte action for each, offset by the real UART byte
   * time (10 bits / baudrate).  The generation timestamp is forwarded on
   * the first byte; packet metadata is preserved on the last byte so that
   * downstream reactors retain full observability.
   *
   * @param emit_e2e  Trigger carrying the fully-formed @c data_packet_t.
   * @param emit_byte Output action; one event per byte, spaced by byte_time_us.
   */
reactor GNSSReceiver(min_bytes: int = 400,  // Dual-constellation baseline
                     max_bytes: int = 800,  // Quad-constellation maximum
                     min_rtcm_messages_per_e2e: int = 1,
                     max_rtcm_messages_per_e2e: int = 6,
                     baudrate: int = 460800,          // Must match UARTDriver baudrate
                     convergence_epochs: int = 1000,   // Phase 1: adaptive learns safe ceiling
                     validation_epochs: int = 1000,     // Phase 2: run at converged ceiling (expect 0 overflows)
                     sweep_epochs: int = 800            // Phase 3: threshold sweep (0 = disabled)
) {
  output rtcm: data_packet_t
  logical action emit_e2e: data_packet_t
  logical action emit_byte: data_packet_t
  timer epoch(0, 100 msec)
  
  state epoch_count: int = 0
  state e2e_counter: int = 0
  
  reaction(startup) {=
    srand(time(NULL));
  =}
  
  reaction(epoch) -> rtcm {=
    int total_epochs = self->convergence_epochs + self->validation_epochs + self->sweep_epochs;
    // Stop after all phases complete.
    if (total_epochs > 0 && self->epoch_count >= total_epochs) {
      printf("[t=%lld ms] [GNSS] All %d epochs done (%d convergence + %d validation + %d sweep) \u2014 requesting stop.\n",
             lf_time_logical() / MSEC(1), total_epochs,
             self->convergence_epochs, self->validation_epochs, self->sweep_epochs);
      lf_request_stop();
      return;
    }
    // Print phase boundary when entering validation phase.
    if (self->epoch_count == self->convergence_epochs && self->convergence_epochs > 0) {
      printf("\n\033[1;35m[t=%lld ms] *** PHASE 2 START: %d convergence epochs done."
             " Running %d validation epochs at converged latency. Expect 0 overflows. ***\033[0m\n\n",
             lf_time_logical() / MSEC(1), self->convergence_epochs, self->validation_epochs);
    }
    // Print phase boundary when entering sweep phase.
    if (self->epoch_count == self->convergence_epochs + self->validation_epochs && self->sweep_epochs > 0) {
      printf("\n\033[1;35m[t=%lld ms] *** PHASE 3 START: Threshold sweep (%d epochs). ***\033[0m\n\n",
             lf_time_logical() / MSEC(1), self->sweep_epochs);
    }
    self->epoch_count++;

    printf("[t=%lld ms] [EPOCH_%d] GNSS generating 1 E2E message\n",
           lf_time_logical() / MSEC(1), self->epoch_count);

    self->e2e_counter = (self->e2e_counter + 1) & 0xFFFF;  // 16-bit wrap: 65535 -> 0

    int min_rtcm = self->min_rtcm_messages_per_e2e;
    int max_rtcm = self->max_rtcm_messages_per_e2e;
    if (min_rtcm < 1) {
      min_rtcm = 1;
    }
    if (max_rtcm < min_rtcm) {
      max_rtcm = min_rtcm;
    }

    int rtcm_count = min_rtcm +
      (rand() % (max_rtcm - min_rtcm + 1));

    data_packet_t packet;
    int bytes_this_e2e = self->min_bytes + (rand() % (self->max_bytes - self->min_bytes + 1));

    build_demo_gnss_packet(&packet,
                            (uint16_t)self->e2e_counter,
                            0x474E5353,
                            rtcm_count,
                            bytes_this_e2e,
                            lf_time_logical());

    // lf_schedule_copy(emit_e2e, 0, &packet, 1);

    printf("[t=%lld ms]   E2E#%d: %d bytes, %d RTCM3 messages\n",
            lf_time_logical() / MSEC(1),
            self->e2e_counter,
            packet.bytes,
            packet.packet_info.rtcm_count);

    // Emit bytes one-by-one so UARTDriver consumes one byte per event.
    // Spacing matches real UART byte time: 10 bits / baudrate.
    // UART framing: 1 start + 8 data + 1 stop = 10 bits per byte.
    int byte_time_us = (10 * 1000000) / self->baudrate;
    // const data_packet_t* packet = &emit_e2e->value;
    for (int i = 0; i < packet.bytes; i++) {
      data_packet_t one_byte = {
        .bytes = 1
      };
      one_byte.data[0] = packet.data[i];

      // Carry generation timestamp once per packet (on first byte).
      if (i == 0) {
        one_byte.generation_time = packet.generation_time;
      }

      // Preserve packet metadata on final byte to keep observability downstream.
      if (i == packet.bytes - 1) {
        one_byte.packet_info = packet.packet_info;
      }

      lf_set(emit_byte, USEC(i * byte_time_us), &one_byte, 1);
    }
  =}
}
