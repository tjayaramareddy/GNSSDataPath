/**
 * @file DataForwarder.lf
 * @brief Simple data forwarder with LF feature demonstration
 * @date 2026-05-13
 * 
 */
target C

preamble {=
  #include "gnss_common.h"
  #include <string.h>
  #include <stdlib.h>
=}

/**
 * DataForwarder Reactor
 *
 * Periodically forwards data from a ring buffer to the network.
 * Tracks timing statistics and demonstrates LF real-time features.
 */
reactor DataForwarder {
  input mem_in: data_packet_t
  timer period(0, 18 msec)
  output network_out: data_packet_t
  
  // Ring buffer state
  state memory_buffer: uint8_t[1024]  // Must match MEM_BUFFER_SIZE in gnss_common.h
  state write_ptr: int = 0
  state read_ptr: int = 0
  state max_buffer_usage: int = 0
  state earliest_gen_time: instant_t = 0
  state has_data: bool = false
  
  // Message corruption tracking
  state total_messages_received: int = 0
  state total_messages_corrupted: int = 0
  state last_packet_info: e2e_packet_info_t
  state last_e2e_counter: int = -1   // -1 = no packet seen yet; valid range 0-65535
  
  // Buffer overflow tracking
  state buffer_overflow_events: int = 0
  state total_bytes_dropped: int = 0
  
  // Statistics
  state total_forwards: int = 0
  state total_bytes_forwarded: int = 0
  state forwarding_deadline_misses: int = 0
  state forwarding_watchdog_triggers: int = 0
  
  // Timing tracking
  state max_execution_lag: interval_t = 0
  state last_logical_time: instant_t = 0
  state last_physical_time: instant_t = 0
  
  // LF WATCHDOG: Detects if periodic forwarding hangs
  watchdog forwarding_watchdog(100 msec) {=
    self->forwarding_watchdog_triggers++;
    printf("\n[t=%lld ms] WATCHDOG: DataForwarder not executing (trigger #%d)\n",
           lf_time_logical() / MSEC(1), self->forwarding_watchdog_triggers);
  =}
  
  reaction(startup) {=
    // LF C target generates array states as uint8_t* with no automatic allocation.
    self->memory_buffer = (uint8_t*)calloc(MEM_BUFFER_SIZE, sizeof(uint8_t));
    printf("[INIT] DataForwarder: period=18ms, deadline=20ms, watchdog=100ms\n");
  =}
  
  reaction(mem_in) {=
    int bytes_to_write = mem_in->value.bytes;
    instant_t gen_time = mem_in->value.generation_time;
    int buffer_size = MEM_BUFFER_SIZE;
    
    // Check if this is a complete packet with message metadata (from transmission end)
    if (mem_in->value.packet_info.rtcm_count > 0) {
      // Store packet info for shutdown report
      self->last_packet_info = mem_in->value.packet_info;
    }
    
    // Track earliest generation time for end-to-end latency
    if (!self->has_data || gen_time < self->earliest_gen_time) {
      self->earliest_gen_time = gen_time;
      self->has_data = true;
    }
    
    // Calculate available space in ring buffer
    int available = (self->write_ptr >= self->read_ptr) ?
                    (buffer_size - self->write_ptr + self->read_ptr) :
                    (self->read_ptr - self->write_ptr);
    
    if (bytes_to_write <= available) {
      // Copy bytes into ring buffer.
      for (int i = 0; i < bytes_to_write; i++) {
        self->memory_buffer[(self->write_ptr + i) % buffer_size] = mem_in->value.data[i];
      }
      self->write_ptr = (self->write_ptr + bytes_to_write) % buffer_size;
      
      // Calculate current buffer occupancy
      int current_usage = (self->write_ptr >= self->read_ptr) ?
                          (self->write_ptr - self->read_ptr) :
                          (buffer_size - self->read_ptr + self->write_ptr);
      
      if (current_usage > self->max_buffer_usage) {
        self->max_buffer_usage = current_usage;
      }
      
      printf("[t=%lld ms] Buffer: +%d bytes (occupancy=%d)\n",
             lf_time_logical() / MSEC(1), bytes_to_write, current_usage);
    } else {
      // Buffer overflow - track for monitoring and analysis
      self->buffer_overflow_events++;
      self->total_bytes_dropped += bytes_to_write;
      
      // Use centralized formatting function
      print_buffer_overflow(lf_time_logical() / MSEC(1), bytes_to_write, available,
                           MEM_BUFFER_SIZE, self->buffer_overflow_events,
                           self->total_bytes_dropped);
    }
  =}
  
  reaction(period) -> network_out, forwarding_watchdog {=
    lf_watchdog_start(forwarding_watchdog, 0);  // Pet watchdog: prove period reaction is alive

    // LF TIME TRACKING: Measure execution lag
    instant_t logical_now = lf_time_logical();
    instant_t physical_now = lf_time_physical();
    interval_t execution_lag = physical_now - logical_now;
    
    if (execution_lag > self->max_execution_lag) {
      self->max_execution_lag = execution_lag;
    }
    
    self->last_logical_time = logical_now;
    self->last_physical_time = physical_now;
    
    int buffer_size = MEM_BUFFER_SIZE;
    int available_data;
    
    // Calculate available data in ring buffer
    if (self->write_ptr >= self->read_ptr) {
      available_data = self->write_ptr - self->read_ptr;
    } else {
      available_data = buffer_size - self->read_ptr + self->write_ptr;
    }
    
    if (available_data > 0 && self->has_data) {
      // Snapshot available bytes — do NOT drain ring buffer yet.
      // read_ptr advances only by bytes belonging to complete packets.
      // Incomplete trailing bytes remain in the ring buffer and accumulate
      // across periods until the full E2E packet has arrived.
      uint8_t staging[MEM_BUFFER_SIZE];
      for (int i = 0; i < available_data; i++)
        staging[i] = self->memory_buffer[(self->read_ptr + i) % buffer_size];

      int consumed = 0;
      while (consumed + E2E_HEADER_SIZE <= available_data) {
        if (!validate_e2e_preamble(&staging[consumed])) {
          consumed++; // Skip non-preamble byte (tail of previous partial packet).
          continue;
        }

        uint16_t e2e_length = ((uint16_t)staging[consumed + 4] << 8) | staging[consumed + 5];

        // Incomplete packet — wait for more bytes in the next period.
        // Reject oversized declared length (malformed packet guard).
        if (e2e_length < E2E_HEADER_SIZE || e2e_length > MEM_BUFFER_SIZE || consumed + (int)e2e_length > available_data)
          break;

        // Complete packet — validate CRC and forward.
        data_packet_t out_packet = {0};
        out_packet.bytes = e2e_length;
        out_packet.generation_time = self->earliest_gen_time;
        memcpy(out_packet.data, &staging[consumed], e2e_length);

        parse_e2e_packet(&out_packet);
        if (!validate_e2e_crc(&out_packet)) {
          self->total_messages_corrupted++;
          printf("[t=%lld ms] CRC FAIL: corrupted packet (%d bytes), dropping (total=%d)\n",
                 lf_time_logical() / MSEC(1), e2e_length, self->total_messages_corrupted);
        } else {
          // Validate E2E counter sequence (16-bit, wraps 65535 -> 0).
          uint16_t rx_counter = out_packet.packet_info.e2e_counter;
          if (self->last_e2e_counter >= 0) {
            uint16_t expected = (uint16_t)((self->last_e2e_counter + 1) & 0xFFFF);
            if (rx_counter != expected) {
              printf("[t=%lld ms] E2E COUNTER ERROR: expected %u, got %u\n",
                     lf_time_logical() / MSEC(1), expected, rx_counter);
            }
          }
          self->last_e2e_counter = rx_counter;

          self->total_forwards++;
          self->total_bytes_forwarded += e2e_length;
          lf_set(network_out, out_packet);
          printf("[t=%lld ms] Forward: %d bytes, %d RTCM3 msgs, E2E counter=%u (total: %d forwards, %d bytes)\n",
                 lf_time_logical() / MSEC(1), e2e_length,
                 out_packet.packet_info.rtcm_count, rx_counter,
                 self->total_forwards, self->total_bytes_forwarded);
        }
        consumed += e2e_length;
      }

      // Advance read_ptr only past fully consumed (complete) packets.
      self->read_ptr = (self->read_ptr + consumed) % buffer_size;
      self->has_data = (self->read_ptr != self->write_ptr);
      // Reset gen_time when buffer is fully drained so the next packet sets its own timestamp.
      if (!self->has_data)
        self->earliest_gen_time = 0;
    } else {
      printf("[t=%lld ms] Forward: idle (no data)\n", lf_time_logical() / MSEC(1));
    }
  =} deadline(20 msec) {=
    // LF DEADLINE HANDLER: Forwarding task exceeded deadline
    self->forwarding_deadline_misses++;
    interval_t lag = lf_time_physical() - lf_time_logical();
    
    printf("[t=%lld ms] DEADLINE VIOLATION: Exceeded 20ms (lag: %.3f ms, violation #%d)\n",
           lf_time_logical() / MSEC(1), lag / 1000.0, self->forwarding_deadline_misses);
  =}
  
  reaction(shutdown) {=
    printf("\n=== DataForwarder Shutdown Report ===\n");
    printf("  Forwarded:        %d packets, %d bytes\n", self->total_forwards, self->total_bytes_forwarded);
    printf("  Corrupted:        %d packets\n", self->total_messages_corrupted);
    printf("  Buffer overflows: %d events, %d bytes dropped\n", self->buffer_overflow_events, self->total_bytes_dropped);
    printf("  Peak occupancy:   %d / %d bytes\n", self->max_buffer_usage, MEM_BUFFER_SIZE);
    printf("  Deadline misses:  %d\n", self->forwarding_deadline_misses);
    printf("  Watchdog triggers:%d\n", self->forwarding_watchdog_triggers);
    printf("  Max exec lag:     %.3f ms\n", self->max_execution_lag / 1000.0);
    printf("====================================\n");
  =}
}